# Render production environment variables for the FastAPI backend.
# Copy these values into Render > Web Service > Environment.
# Do not commit a real .env file with secrets.

ENVIRONMENT=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
SECRET_KEY=REPLACE_WITH_RANDOM_48_PLUS_CHAR_SECRET
MFA_ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
CORS_ORIGINS=https://placeholder.vercel.app
SHOW_DOCS=false
SEED_DEV_DATA=false
SEED_MOCK_DATA=false
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Only needed once when running the production bootstrap manually.
BOOTSTRAP_TENANT_NAME=DataLegal MVP
BOOTSTRAP_TENANT_RUC=1799999999001
BOOTSTRAP_ADMIN_EMAIL=admin@datalegal.local
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
BOOTSTRAP_ADMIN_NAME=Administrador DataLegal
